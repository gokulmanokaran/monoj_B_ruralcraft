# ==============================================================================
# RURALCRAFT GLOBAL - CUSTOMER & ARTISAN FRONTEND (Vercel Deployment 1)
# ==============================================================================

# Backend API Base URL
# - In local development: Leave empty to automatically use Vite's /api proxy to http://localhost:5000
# - On Vercel: Set to your deployed backend API URL (e.g., https://api.ruralcraft.global/api or Render/Railway URL)
VITE_API_BASE=

# Supabase Credentials (if accessing Supabase PostgreSQL directly from frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# URL of the separate Admin Panel (Vercel Deployment 2)
# - In local development: http://localhost:5174
# - On Vercel: https://ruralcraft-admin.vercel.app
VITE_ADMIN_URL=http://localhost:5174
