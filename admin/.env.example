# ==============================================================================
# RURALCRAFT GLOBAL - ADMIN PANEL FRONTEND (Vercel Deployment 2)
# ==============================================================================

# Backend API Base URL
# - In local development: Leave empty to automatically use Vite's /api proxy to http://localhost:5000
# - On Vercel: Set to your deployed backend API URL (e.g., https://api.ruralcraft.global/api or Render/Railway URL)
VITE_API_BASE=

# Supabase Credentials (shares the same database as the main frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# URL of the Main Customer/Artisan Frontend (Vercel Deployment 1)
# - In local development: http://localhost:5173
# - On Vercel: https://ruralcraft-global.vercel.app
VITE_MAIN_APP_URL=http://localhost:5173
